# Everest Aires y Frío — configuración para hosting Apache/LiteSpeed (Hostinger)

# Forzar HTTPS y dominio con www (descomenta cuando el SSL esté activo)
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.everestairesyfrio.com%{REQUEST_URI} [L,R=301]

AddType image/svg+xml .svg
AddType image/webp .webp
AddDefaultCharset UTF-8

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>

# Caché del navegador (mejora velocidad y Quality Score)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /index.html

# Archivos de trabajo que no deben ser públicos (por si se suben por error)
RedirectMatch 404 ^/_generador(/|$)
RedirectMatch 404 \.(md|py)$

# >>> REDIRECCIONES (generado por _generador/generar.py, no editar a mano)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^equipos/chiller-9000-btu\.html$ /chillers.html#chiller-9000-btu [R=301,NE,L]
RewriteRule ^equipos/chiller-12000-btu\.html$ /chillers.html#chiller-12000-btu [R=301,NE,L]
RewriteRule ^equipos/chiller-cw-3000\.html$ /chillers.html#chiller-cw-3000 [R=301,NE,L]
RewriteRule ^equipos/chiller-3-tr\.html$ /chillers.html#chiller-3-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-5-tr\.html$ /chillers.html#chiller-5-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-5-toneladas\.html$ /chillers.html#chiller-5-toneladas [R=301,NE,L]
RewriteRule ^equipos/chiller-60000-btu\.html$ /chillers.html#chiller-60000-btu [R=301,NE,L]
RewriteRule ^equipos/chiller-7-5-toneladas\.html$ /chillers.html#chiller-7-5-toneladas [R=301,NE,L]
RewriteRule ^equipos/chiller-10-tr\.html$ /chillers.html#chiller-10-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-20-tr\.html$ /chillers.html#chiller-20-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-25-tr\.html$ /chillers.html#chiller-25-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-30-tr\.html$ /chillers.html#chiller-30-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-40-tr\.html$ /chillers.html#chiller-40-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-60-tr\.html$ /chillers.html#chiller-60-tr [R=301,NE,L]
RewriteRule ^equipos/chiller-100-toneladas\.html$ /chillers.html#chiller-100-toneladas [R=301,NE,L]
RewriteRule ^equipos/mini-split\.html$ /aire-acondicionado.html#mini-split [R=301,NE,L]
RewriteRule ^equipos/multi-split\.html$ /aire-acondicionado.html#multi-split [R=301,NE,L]
RewriteRule ^equipos/piso-techo\.html$ /aire-acondicionado.html#piso-techo [R=301,NE,L]
RewriteRule ^equipos/cassette\.html$ /aire-acondicionado.html#cassette [R=301,NE,L]
RewriteRule ^equipos/centralizado-ductos\.html$ /aire-acondicionado.html#centralizado-ductos [R=301,NE,L]
RewriteRule ^equipos/cuarto-frio-conservacion\.html$ /cuartos-frios.html#cuarto-frio-conservacion [R=301,NE,L]
RewriteRule ^equipos/cuarto-frio-congelacion\.html$ /cuartos-frios.html#cuarto-frio-congelacion [R=301,NE,L]
RewriteRule ^equipos/diseno-calculo-aire\.html$ /aire-acondicionado.html#diseno-calculo-aire [R=301,NE,L]
RewriteRule ^equipos/diseno-cuartos-frios\.html$ /cuartos-frios.html#diseno-cuartos-frios [R=301,NE,L]
RewriteRule ^equipos/ /catalogo.html [R=301,L]
</IfModule>
# <<< REDIRECCIONES
